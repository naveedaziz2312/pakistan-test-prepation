*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif}
body{background:#f6f8ff;color:#1a1a2e}
a{text-decoration:none}
header{background:#fff;padding:14px 5%;display:flex;justify-content:space-between;align-items:center;box-shadow:0 2px 15px rgba(0,0,0,.08);position:sticky;top:0;z-index:100}
.logo{font-size:22px;font-weight:800;color:#0b3d91;line-height:1}
.logo span{color:#00a651}
.logo small{font-size:10px;letter-spacing:2px;color:#666;display:block}
nav a{margin-left:18px;color:#333;font-weight:600;font-size:14px}
nav a.active,nav a:hover{color:#0b3d91}
.top-btn{background:#25D366;color:#fff;padding:9px 18px;border-radius:20px;font-weight:700;font-size:14px}
.hero{background:linear-gradient(135deg,#0b3d91 0%,#00a651 100%);color:#fff;padding:55px 5%;display:flex;flex-wrap:wrap;gap:30px;align-items:center}
.hero-text{flex:1;min-width:290px}
.pill{background:rgba(255,255,255,.2);padding:7px 14px;border-radius:20px;font-size:13px;display:inline-block}
.hero-text h1{font-size:40px;line-height:1.2;margin:18px 0}
.hero-text h1 span{color:#ffdd00}
.hero-text p{opacity:.95}
.hero-btns{margin:20px 0;display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:13px 24px;border-radius:30px;font-weight:700;font-size:15px;border:none;cursor:pointer}
.btn-white{background:#fff;color:#0b3d91}
.btn-yellow{background:#ffdd00;color:#111}
.btn-green{background:#00a651;color:#fff}
.btn-blue{background:#0b3d91;color:#fff}
.full{width:100%;text-align:center;display:block}
.stats{display:flex;gap:25px;margin-top:20px}
.stats b{font-size:20px}
.section{padding:50px 5%}
.center{text-align:center}
.sub{color:#666;margin:8px 0 28px}
.section h2{font-size:30px;color:#0b3d91}
.white{background:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.card{background:#fff;padding:26px;border-radius:18px;box-shadow:0 5px 20px rgba(0,0,0,.07);text-align:center}
.card i{font-size:35px;color:#00a651;margin-bottom:12px}
.card h3{margin-bottom:8px}
.card p{font-size:14px;color:#666;margin-bottom:12px}
.card a{color:#0b3d91;font-weight:700}
.job-box{background:#f6f8ff;border:1px solid #e5e9ff;padding:18px;border-radius:15px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.badge{background:#e6f9ee;color:#00a651;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:700}
.hero-card{background:#fff;color:#111;padding:28px;border-radius:20px;flex:1;min-width:280px;max-width:360px;text-align:center;box-shadow:0 15px 30px rgba(0,0,0,.25)}
.hero-card h3{color:#0b3d91}
.hero-card .big{font-size:48px;font-weight:800;color:#00a651;margin:10px 0}
.small{font-size:12px;color:#888;margin-top:10px}
.about-box{background:#fff;border-radius:20px;padding:30px;display:flex;gap:25px;flex-wrap:wrap;align-items:center;box-shadow:0 5px 20px rgba(0,0,0,.06)}
.about-box img{width:170px;height:170px;object-fit:cover;border-radius:50%;border:5px solid #00a651}
.about-box h2{color:#0b3d91}
.green{color:#00a651}
input,select,textarea{width:100%;padding:13px;margin-bottom:12px;border:1px solid #ddd;border-radius:10px;outline:none;font-size:15px}
.quiz-box{background:linear-gradient(135deg,#fff3cd,#fff);border:2px dashed #ffb800;padding:30px;border-radius:20px;text-align:center;margin-top:20px}
.paper-card{background:#fff;padding:25px;border-radius:18px;text-align:center;box-shadow:0 5px 20px rgba(0,0,0,.06)}
footer{background:#0b1a33;color:#fff;text-align:center;padding:30px 5%}
footer p{opacity:.8;font-size:13px;margin-top:8px}
.whatsapp{position:fixed;bottom:20px;right:20px;background:#25D366;color:#fff;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;box-shadow:0 8px 20px rgba(0,0,0,.3);z-index:999}
@media(max-width:700px){.hero-text h1{font-size:28px}nav{display:none}.hero-card{max-width:100%}}
